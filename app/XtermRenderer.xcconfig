// Xterm.js Renderer Configuration
// ARM64 apps include this configuration by default (Canvas with ligatures).
// Override TERMINAL_RENDERER_DEFINES=USE_XTERM_RENDERER=0 to use Ghostty Web.

TERMINAL_RENDERER_DEFINES = USE_XTERM_RENDERER=1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) $(TERMINAL_RENDERER_DEFINES)
